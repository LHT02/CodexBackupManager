{
  "name": "codex-backup-manager",
  "version": "1.0.0",
  "description": "Codex configuration, session, skill and desktop data backup and restore utility",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "LHT02",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/LHT02/CodexBackupManager#readme",
  "bugs": {
    "url": "https://github.com/LHT02/CodexBackupManager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LHT02/CodexBackupManager.git"
  },
  "keywords": [
    "codex",
    "backup",
    "restore",
    "migration",
    "electron"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:app": "concurrently -k \"npm:dev\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "build": "npm run build:icon && npm run build:renderer && electron-builder --win portable --x64",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:packaged": "node scripts/smoke-electron.mjs \"release/win-unpacked/Codex 备份管家.exe\"",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build:renderer"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.2.8",
    "@mui/material": "9.3.1",
    "archiver": "8.0.0",
    "material-symbols": "0.45.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.45.10",
    "@rolldown/binding-win32-x64-msvc": "^1.2.3",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "42.8.1",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.62.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.lht02.codexbackupmanager",
    "productName": "Codex 备份管家",
    "artifactName": "Codex-Backup-Manager-${version}-Portable.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Codex-Backup-Manager-${version}-Portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
